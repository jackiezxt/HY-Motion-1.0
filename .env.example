# ── Nova LLM Proxy ──────────────────────────────────────────
# 申请 Key: https://console.tapsvc.com/nova/#/ai-gateway
PROMPT_API_HOST=https://llm-proxy.tapsvc.com/v1
PROMPT_API_KEY=your_nova_llm_api_key_here
PROMPT_API_MODEL=qwen/qwen3.6-plus

# ── 网络代理 ─────────────────────────────────────────────────
HTTP_PROXY=http://10.236.255.12:18888
HTTPS_PROXY=http://10.236.255.12:18888
NO_PROXY=localhost,127.0.0.1
no_proxy=localhost,127.0.0.1

# ── 模型加载 ─────────────────────────────────────────────────
USE_HF_MODELS=0
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
LAZY_TEXT_ENCODER=1

# ── GPU 显存管理 ──────────────────────────────────────────────
AUTO_UNLOAD_PROMPTER=1
AUTO_CLEAN_GPU_CACHE=1
AUTO_UNLOAD_MODEL=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# ── Prompt Engineering（取消注释可禁用）──────────────────────
# DISABLE_PROMPT_ENGINEERING=True
